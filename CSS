/* Sanjeevani patient and medical-shop authentication interface */
:root {
	--auth-blue: #1769d2;
	--auth-blue-dark: #0c438e;
	--auth-ink: #18304f;
	--auth-muted: #71839c;
	--auth-border: #dce6f2;
}

* { box-sizing: border-box; }

body {
	min-height: 100vh;
	margin: 0;
	padding: 28px 16px;
	display: grid;
	place-items: center;
	color: var(--auth-ink);
	font-family: Inter, "Segoe UI", Arial, sans-serif;
	background: radial-gradient(circle at 15% 15%, #62b8ff 0, transparent 32%),
		radial-gradient(circle at 90% 85%, #318de8 0, transparent 30%),
		linear-gradient(135deg, #083b82, #1478db 58%, #39a9ec);
}

/* Wrap the form and welcome panel in .auth-card. */
.auth-card {
	width: min(100%, 960px);
	min-height: 580px;
	display: grid;
	grid-template-columns: 0.88fr 1.12fr;
	overflow: hidden;
	border: 1px solid rgb(255 255 255 / 45%);
	border-radius: 26px;
	background: #fff;
	box-shadow: 0 28px 75px rgb(3 28 69 / 30%);
}

.auth-welcome {
	position: relative;
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	padding: 42px;
	overflow: hidden;
	color: #fff;
	background: linear-gradient(155deg, var(--auth-blue-dark), #1679df 65%, #39a9ec);
}

.auth-welcome::after {
	position: absolute;
	right: -120px;
	bottom: -145px;
	width: 330px;
	height: 330px;
	border: 1px solid rgb(255 255 255 / 22%);
	border-radius: 50%;
	box-shadow: 0 0 0 28px rgb(255 255 255 / 6%), 0 0 0 60px rgb(255 255 255 / 5%);
	content: "";
}

.auth-brand {
	position: relative;
	z-index: 1;
	display: flex;
	align-items: center;
	gap: 11px;
	font-size: 1.2rem;
	font-weight: 750;
}

.auth-brand-icon {
	width: 42px;
	height: 42px;
	display: grid;
	place-items: center;
	border: 1px solid rgb(255 255 255 / 35%);
	border-radius: 14px;
	background: rgb(255 255 255 / 15%);
	font-size: 1.45rem;
}

.auth-welcome-copy { position: relative; z-index: 1; max-width: 350px; }
.auth-welcome-copy h1 { margin: 0 0 14px; font-size: clamp(2rem, 4vw, 2.8rem); line-height: 1.12; }
.auth-welcome-copy p, .auth-trust-note { color: rgb(255 255 255 / 83%); line-height: 1.7; }
.auth-trust-note { position: relative; z-index: 1; margin: 0; font-size: .87rem; }

.auth-main { align-self: center; padding: 44px clamp(25px, 6vw, 66px); }
.auth-main h2 { margin: 0 0 8px; font-size: 1.8rem; letter-spacing: -.5px; }
.auth-description { margin: 0 0 24px; color: var(--auth-muted); line-height: 1.55; }

/* Use buttons or links inside .auth-tabs; mark the selected one .is-active. */
.auth-tabs {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 5px;
	margin-bottom: 24px;
	padding: 5px;
	border-radius: 13px;
	background: #f0f5fc;
}

.auth-tabs > * {
	min-height: 43px;
	display: grid;
	place-items: center;
	border: 0;
	border-radius: 10px;
	color: #64758e;
	background: transparent;
	font: inherit;
	font-size: .9rem;
	font-weight: 650;
	text-decoration: none;
	cursor: pointer;
}

.auth-tabs > .is-active, .auth-tabs > [aria-selected="true"] {
	color: var(--auth-blue-dark);
	background: #fff;
	box-shadow: 0 2px 9px rgb(21 65 124 / 10%);
}

.auth-form { display: grid; gap: 16px; }
.auth-field { display: grid; gap: 7px; }
.auth-field label { color: #334867; font-size: .87rem; font-weight: 650; }
.auth-field input, .auth-field select {
	width: 100%;
	min-height: 47px;
	padding: 0 14px;
	border: 1px solid var(--auth-border);
	border-radius: 11px;
	outline: 0;
	color: var(--auth-ink);
	background: #fbfdff;
	font: inherit;
	transition: border-color .18s, box-shadow .18s, background .18s;
}

.auth-field input::placeholder { color: #a0adbf; }
.auth-field input:focus, .auth-field select:focus { border-color: #3986e5; background: #fff; box-shadow: 0 0 0 4px rgb(38 120 232 / 12%); }
.auth-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.auth-options { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: .85rem; }
.auth-remember { display: flex; align-items: center; gap: 8px; color: #53647c; }
.auth-remember input { accent-color: var(--auth-blue); }
.auth-link { color: var(--auth-blue-dark); font-weight: 650; text-decoration: none; }
.auth-link:hover { text-decoration: underline; }

.auth-submit {
	min-height: 49px;
	margin-top: 3px;
	border: 0;
	border-radius: 11px;
	color: #fff;
	background: linear-gradient(100deg, #1261c6, #2588ef);
	box-shadow: 0 8px 18px rgb(25 105 207 / 23%);
	font: inherit;
	font-weight: 700;
	cursor: pointer;
	transition: transform .18s, box-shadow .18s;
}

.auth-submit:hover { transform: translateY(-1px); box-shadow: 0 11px 22px rgb(25 105 207 / 30%); }
.auth-switch { margin: 21px 0 0; color: var(--auth-muted); text-align: center; font-size: .9rem; }

@media (max-width: 720px) {
	body { padding: 16px 12px; }
	.auth-card { max-width: 500px; min-height: 0; grid-template-columns: 1fr; border-radius: 22px; }
	.auth-welcome { min-height: 180px; padding: 22px 27px; }
	.auth-welcome-copy { margin-top: 25px; }
	.auth-welcome-copy h1 { font-size: 1.8rem; }
	.auth-welcome-copy p, .auth-trust-note { display: none; }
	.auth-main { padding: 30px 27px 35px; }
}

@media (max-width: 420px) {
	.auth-row { grid-template-columns: 1fr; }
	.auth-main { padding-inline: 21px; }
}
